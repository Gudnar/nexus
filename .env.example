# Rol de la aplicacion (SIN BYPASSRLS) - usado por la API en runtime
DATABASE_URL="postgresql://erp_app:erp_app_pass@localhost:5432/erp?schema=public"
# Rol propietario - solo para migraciones y seeds
DIRECT_URL="postgresql://erp_owner:erp_owner_pass@localhost:5432/erp?schema=public"
# Rol de plataforma (registro autoservicio y consola del administrador global; también sujeto a RLS)
PLATFORM_DATABASE_URL="postgresql://erp_platform:erp_platform_pass@localhost:5432/erp?schema=public"
# Rol del dispatcher del outbox (lee eventos de todos los tenants; sin él no se despacha)
WORKER_DATABASE_URL="postgresql://erp_worker:erp_worker_pass@localhost:5432/erp?schema=public"
# OUTBOX_POLL_MS=2000
# OUTBOX_MAX_ATTEMPTS=5

REDIS_URL="redis://localhost:6379"

JWT_ACCESS_SECRET="cambiar-por-un-secreto-largo-y-aleatorio"
JWT_REFRESH_SECRET="cambiar-por-otro-secreto-largo-y-aleatorio"
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL="30d"

# Archivos: "local" (disco) o "s3"
STORAGE_DRIVER="local"
STORAGE_PATH="./storage"

# Cifrado de secretos TOTP en reposo (>= 32 caracteres, distinta de los secretos JWT)
MFA_ENCRYPTION_KEY="cambiar-por-otra-clave-larga-y-aleatoria"

# Correo: "log" guarda los mensajes en un buzón de desarrollo (GET /api/v1/dev/mailbox); "smtp" envía de verdad.
MAIL_TRANSPORT="log"
# SMTP_URL="smtps://usuario:clave@smtp.ejemplo.com:465"
MAIL_FROM="NEXUS ERP <no-reply@tu-dominio.com>"
# URL pública de la web (enlaces de los correos)
APP_PUBLIC_URL="http://localhost:3001"
# Proxies de confianza para leer la IP real del cliente
TRUST_PROXY="127.0.0.1,::1"
